# Copiar a .env y ajustar. El archivo .env No se sube al repositorio.

# --- Base de datos: MySQL 8 (db_udv del Grupo 1) con el driver PyMySQL ---
# Formato: mysql+pymysql://USUARIO:CLAVE@HOST:PUERTO/db_udv
# Opción A (Recomendada): MySQL de Docker. Desde la raíz del repo: docker compose up -d db
# El usuario y la clave son los MYSQL_USER y MYSQL_PASSWORD del .env de la raíz; el puerto local es MYSQL_PORT_LOCAL.
DATABASE_URL=mysql+pymysql://TU_USUARIO:TU_CLAVE@TU_HOST:TU_PUERTO/db_udv
# Opción B: MySQL o MariaDB de XAMPP con los scripts del Grupo 1 importados (usuario y puerto de tu XAMPP).
# Orden: 01_schema.sql y después 02_seed.sql (En grupos/grupo-1-base-de-datos/Docs/sql/). También sirve: python -m g1_bd crear
# Ojo: 01_schema.sql borra y recrea db_udv. Úsalo solo en tu base local.
# DATABASE_URL=mysql+pymysql://TU_USUARIO:TU_CLAVE@TU_HOST:TU_PUERTO/db_udv
# Opción C: Base compartida del PM (Railway). La clave la da el PM por privado: Va "Solo" en tu .env, nunca aquí.
# Lo que borres lo ven los demás grupos: No corras scripts que borren ni creen tablas contra esta base.
# Para integración y pruebas manuales con QA. pytest "No" la usa: Siempre corre con SQLite temporal.
# DATABASE_URL=mysql+pymysql://TU_USUARIO:TU_CLAVE@TU_HOST:TU_PUERTO/db_udv

# --- Firma de tokens JWT (PyJWT) ---
# Generar uno propio: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=TU_CLAVE_SECRETA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- CORS: Orígenes del frontend permitidos, separados por coma ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Login: Intentos fallidos permitidos y minutos de bloqueo ---
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# --- Contraseña: largo mínimo y máximo ---
CONTRASENA_MIN=8
CONTRASENA_MAX=64

# --- Archivos subidos (files.py): Carpeta local, no se sube al repo ---
UPLOAD_DIR=almacen_archivos

