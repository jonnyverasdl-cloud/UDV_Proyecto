    {
      "name": "2. Submit sin Archivo (Validar Tipo 3)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_docente}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{url_base}}/assignments/{{asignacion_id}}/submit",
          "host": [
            "{{url_base}}"
          ],
          "path": [
            "assignments",
            "{{asignacion_id}}",
            "submit"
          ]
        },
        "description": "Debe dar 422 Unprocessable Entity si la tarea es tipo 3 (requiere_archivo = 1) y el docente no adjuntó evidencia previa."
      },
      "response": []
    },
    {
      "name": "3. Review con Revisor No Asignado (Validar 403)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_revisor_ajeno}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"comentario\": \"Intento de revisión no autorizada para validar seguridad\"\n}"
        },
        "url": {
          "raw": "{{url_base}}/tasks/{{tarea_id}}/review",
          "host": [
            "{{url_base}}"
          ],
          "path": [
            "tasks",
            "{{tarea_id}}",
            "review"
          ]
        },
        "description": "Debe dar 403 Forbidden si el usuario tiene rol reviewer pero no es el revisor_id asignado a esta tarea."
      },
      "response": []
    }
