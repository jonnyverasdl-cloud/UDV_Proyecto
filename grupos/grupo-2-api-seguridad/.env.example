# Copiar a .env y ajustar. El archivo .env No se sube al repositorio.

# --- Base de datos ---
# Motor oficial: MySQL 8 (base db_udv del Grupo 1), driver PyMySQL.
# Formato: mysql+pymysql://USUARIO:CLAVE@HOST:PUERTO/db_udv?charset=utf8mb4

# Opción A (recomendada): MySQL local con Docker, desde la raíz del repo: docker compose up db
# El usuario y la clave son los MYSQL_USER y MYSQL_PASSWORD del .env de la raíz. Puerto local: 3307.
# DATABASE_URL=mysql+pymysql://udv_app:cambiar_clave_local@localhost:3307/db_udv?charset=utf8mb4

# Opción B: base compartida de Railway (solo integración y demo). El PM entrega el usuario por privado.
# DATABASE_URL=mysql+pymysql://USUARIO:CLAVE@HOST:PUERTO/db_udv?charset=utf8mb4

# Opción C: SQLite local, solo para correr las pruebas o desarrollar sin Docker.
# No tiene las tablas del Grupo 1; mientras los routers usen el JSON de prueba funciona igual.
DATABASE_URL=sqlite:///./dev.db

# --- Firma de tokens JWT (PyJWT) ---
# Generar uno propio: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar_por_un_valor_largo_y_aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- CORS: orígenes permitidos, separados por coma ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Login: intentos fallidos permitidos y minutos de bloqueo ---
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
