# Copiar a .env y cambiar los valores. El .env NO se sube al repositorio.
# Ningún valor real va aquí ni en el chat: solo en .env (local) o en Railway (Variables).

# --- Obligatorias para que la app arranque ---
# Clave para firmar los tokens del G2 (mínimo 32 caracteres aleatorios).
SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria
# Conexión a la base db_udv del G1. Local (docker compose):
DATABASE_URL=mysql+pymysql://udv_app:cambiar_clave_local@127.0.0.1:3307/db_udv

# --- Local (docker compose) ---
MYSQL_ROOT_PASSWORD=cambiar_root_local
MYSQL_USER=udv_app
MYSQL_PASSWORD=cambiar_clave_local
MYSQL_PORT_LOCAL=3307

# --- Opcionales ---
# Carpeta donde el G2 guarda los archivos subidos (en Railway: el volumen, /app/uploads).
UPLOAD_DIR=uploads
# Orígenes permitidos para CORS, separados por coma (vacío = mismo origen).
CORS_ORIGINS=
# Máximo de per_page en los listados.
PER_PAGE_MAX=100

# --- Pruebas de integración del PM (tests/integracion) ---
# Base desechable, nunca la de Railway.
# UDV_TEST_MYSQL_URL=mysql+pymysql://udv_app:cambiar_clave_local@127.0.0.1:3307/db_udv

# --- Railway ---
# En el servicio de la app (Variables), DATABASE_URL se arma con las
# variables del servicio MySQL, apuntando a la base db_udv:
# DATABASE_URL=mysql+pymysql://${{MySQL.MYSQLUSER}}:${{MySQL.MYSQLPASSWORD}}@${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/db_udv
# SECRET_KEY y UPLOAD_DIR también se definen ahí.
