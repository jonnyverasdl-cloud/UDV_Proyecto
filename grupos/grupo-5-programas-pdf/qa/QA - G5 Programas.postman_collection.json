  "item": [
    {
      "name": "A. Flujo de Negocio",
      "item": [
        {
          "name": "G5-01A - Crear programa base",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status es 201', function () { pm.response.to.have.status(201); });",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set('programa_id', jsonData.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo_curso\": \"ING101\",\n  \"nombre\": \"Matemática Aplicada\",\n  \"periodo\": \"2027-1\",\n  \"sede\": \"Central\"\n}"
            },
            "url": {
              "raw": "{{url_base}}/course-programs",
              "host": [
                "{{url_base}}"
              ],
              "path": [
                "course-programs"
              ]
            }
          },
          "response": []
        },
        {
          "name": "G5-01B - Crear versión borrador (draft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 y estado draft', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.state || jsonData.estado).to.eql('draft');",
                  "    if (jsonData.id) { pm.collectionVariables.set('version_id', jsonData.id); }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accion\": \"crear_nueva\"\n}"
            },
            "url": {
              "raw": "{{url_base}}/course-programs/{{programa_id}}/versions",
              "host": [
                "{{url_base}}"
              ],
              "path": [
                "course-programs",
                "{{programa_id}}",
                "versions"
              ]
            }
          },
          "response": []
