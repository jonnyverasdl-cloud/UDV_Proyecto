# Copiar a .env y ajustar. El archivo .env No se sube al repositorio.

# Base oficial: MySQL 8 con el esquema del Grupo 1 (README del PM §5).
DATABASE_URL=mysql+pymysql://udv_app:cambiar_clave_local@localhost:3307/db_udv

# Firma de tokens JWT (PyJWT). Generar uno propio: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar_por_un_valor_largo_y_aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS: Origenes permitidos, separados por coma
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Login: Intentos fallidos permitidos y minutos de bloqueo
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
